<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_collapsed_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="3dp"
    android:paddingEnd="4dp"
    android:paddingBottom="3dp">

    <!-- Cover Art Squircle Stile Album Spotify -->
    <ImageView
        android:id="@+id/notif_collapsed_cover"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="Data e Badge"
        android:scaleType="centerCrop" />

    <!-- Dettagli Brano/Briefing e Mini Timeline -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_collapsed_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Briefing Mattutino"
            android:textColor="#FFFFFFFF"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_collapsed_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Prossimo: 09:30 • Caricamento..."
            android:textColor="#FFCBD5E1"
            android:textSize="11.5sp" />

        <!-- Mini Timeline Scrubber stile Spotify -->
        <ProgressBar
            android:id="@+id/notif_collapsed_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2.5dp"
            android:layout_marginTop="5dp"
            android:indeterminate="false"
            android:max="100"
            android:progress="35"
            android:progressTint="#FF8C1D35" />

    </LinearLayout>

</LinearLayout>
