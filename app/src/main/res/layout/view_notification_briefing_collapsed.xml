<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_collapsed_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_notification_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <!-- Cover Art Quadrata -->
    <ImageView
        android:id="@+id/notif_collapsed_cover"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_notification_cover"
        android:contentDescription="Data e Badge"
        android:scaleType="centerCrop" />

    <!-- Dettagli Testuali -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_collapsed_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Briefing Mattutino"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_collapsed_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Prossimo: 09:30 • Caricamento..."
            android:textColor="#FFFFB3C0"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_collapsed_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="📍 Luogo sopralluogo"
            android:textColor="#FFCBD5E1"
            android:textSize="10.5sp" />
    </LinearLayout>

    <!-- Bottone Azione Rapida Mappe -->
    <TextView
        android:id="@+id/notif_collapsed_action_maps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_notification_action_primary"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:text="🗺️ Mappa"
        android:textColor="#FFFFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
