<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Tutto il traffico internet (Hugging Face, GitHub OTA) deve obbligatoriamente utilizzare HTTPS (TLS) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Eccezioni di traffico in chiaro consentite esclusivamente per server LLM locali (Ollama / RizzoFlow su localhost/emulatore) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
