<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Esclude dal cloud backup automatico tutti i dati sensibili delle perizie e dei clienti -->
        <exclude domain="file" path="Perizie_Archivio" />
        <exclude domain="file" path="fascicoli_studio.json" />
        <exclude domain="file" path="chat_history.json" />
        <exclude domain="file" path="calendar_events.json" />
        <exclude domain="file" path="ai_engine_config.json" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="Perizie_Archivio" />
        <exclude domain="file" path="fascicoli_studio.json" />
        <exclude domain="file" path="chat_history.json" />
        <exclude domain="file" path="calendar_events.json" />
        <exclude domain="file" path="ai_engine_config.json" />
    </device-transfer>
</data-extraction-rules>
